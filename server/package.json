{
  "name": "@dnevnik/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dnevnik --local",
    "db:migrate": "wrangler d1 migrations apply dnevnik --remote",
    "setup:bot": "node scripts/setup-bot.mjs",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@dnevnik/shared": "*",
    "drizzle-orm": "^0.36.4",
    "grammy": "^1.32.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/node": "^22.20.3",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
